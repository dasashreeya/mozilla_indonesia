# Competition data may contain restricted or personally identifying material,
# and the rules forbid publishing or redistributing it. MDC archives download
# to the working directory by default, so the root patterns matter as much as
# the data/ ones -- the Jember and development archives were sitting untracked
# but unignored at the repository root on 2026-09-07, one `git add -A` from a
# public push.
data/downloads/
data/*.tar.gz
*.tar.gz
*.tgz
*.zip
data/audit/
data/recovery-*/
reports/private/
data/subsets/
data/dev_runtime/
data/jember_segments/
models/
artifacts/
runtime/
experiments/predictions/

# Keep the small, public submission schemas downloaded from the competition.
!data/reference/
!data/reference/*.csv

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.DS_Store
